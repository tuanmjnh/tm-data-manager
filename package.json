{
  "name": "udmt",
  "version": "0.1.0",
  "private": true,
  "description": "Universal Data Management Tool - export/import data across sources",
  "type": "module",
  "bin": {
    "udmt": "./dist/cli/bin.js"
  },
  "exports": {
    ".": "./dist/core/index.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "check:i18n": "node scripts/check-i18n.mjs",
    "udmt": "node --no-warnings=ExperimentalWarning dist/cli/bin.js",
    "dev": "pnpm run udmt -- gui",
    "dev:gui": "pnpm --filter udmt-gui run dev",
    "build:gui": "pnpm --filter udmt-gui run generate",
    "gui": "pnpm run build && pnpm run build:gui && pnpm run udmt -- gui",
    "fixtures": "node data/fixtures/make-source.mjs",
    "build:runtime": "node scripts/prepare-desktop.mjs",
    "desktop": "node scripts/desktop.mjs",
    "desktop:prepare": "pnpm run build && pnpm run build:gui && node scripts/prepare-desktop.mjs"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "mongodb": "^6.12.0",
    "mysql2": "^3.12.0",
    "pg": "^8.13.1",
    "pg-cursor": "^2.22.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@12.15.0"
}